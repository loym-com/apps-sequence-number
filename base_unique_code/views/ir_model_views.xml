<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_model_view_form" model="ir.ui.view">
        <field name="name">ir.model.view.form</field>
        <field name="model">ir.model</field>
        <field name="inherit_id" ref="base.view_model_form" />
        <field name="arch" type="xml">
            <field name="modules" position="after">
                <field name="unique_code_field_exists" invisible="1"/>
                <field name="sequence_option" invisible="not unique_code_field_exists"/>
                <field name="sequence_id" invisible="sequence_option != 'one'"/>
                <field name="sequence_field_id" invisible="sequence_option != 'field'"/>
                <button
                    name="action_goto_sequences"
                    type="object"
                    icon="fa-list"
                    invisible="not sequence_field_id"
                    title="Sequences"
                />
                <field name="unique_code_expression" invisible="not unique_code_field_exists"/>
            </field>
        </field>
    </record>
</odoo>
