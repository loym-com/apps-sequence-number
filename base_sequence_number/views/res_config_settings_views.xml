<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="res_config_settings_view_form" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.base_sequence_number</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="base.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//block[@name='contacts_setting_container']" position="inside">
                    <setting
                        string="Contact No. Expression"
                        documentation="https://github.com/loym-com/apps-sequence/blob/18.0/base_sequence_number/readme/CONFIGURE.md"
                    >
                        <field name="res_partner_number_expression" placeholder="{r.sequence_code}" class="w-100"/>
                    </setting>
                    <setting
                        string="Contact No. Sequence"
                        documentation="https://github.com/loym-com/apps-sequence/blob/18.0/base_sequence_number/readme/CONFIGURE.md"
                    >
                        <div class="content-group">
                            <div class="row mt16">
                                <field name="res_partner_number_sequence_option" class="w-100"/>
                            </div>
                            <div class="row mt16" invisible="res_partner_number_sequence_option != 'sequence'">
                                <field name="res_partner_number_sequence_id" class="w-100"/>
                            </div>
                            <div class="row mt16" invisible="res_partner_number_sequence_option != 'field'">
                                <div class="d-inline-flex">
                                    <field
                                        name="res_partner_number_sequence_field_id"
                                        class="w-100"
                                        options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"
                                        domain="[('model', '=', 'res.partner'), ('ttype', 'in', ['boolean', 'many2one', 'selection'])]"
                                    />
                                    <button
                                        name="res_partner_action_goto_sequences"
                                        type="object"
                                        icon="fa-list"
                                        invisible="not res_partner_number_sequence_field_id"
                                        title="Sequences"
                                    />
                                </div>
                            </div>
                        </div>
                    </setting>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
