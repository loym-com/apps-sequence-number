<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_model_view_form" model="ir.ui.view">
        <field name="name">ir.model.view.form</field>
        <field name="model">ir.model</field>
        <field name="inherit_id" ref="base.view_model_form" />
        <field name="arch" type="xml">
            <field name="modules" position="after">
                <field name="number_field_exists" invisible="1"/>
                <field name="number_expression" invisible="not number_field_exists" placeholder="{sequence_code}"/>
                <field name="number_sequence_option" invisible="not number_field_exists"/>
                <field name="number_sequence_id" invisible="number_sequence_option != 'sequence'"/>
                <field name="model" invisible="1"/>
                <label for="number_sequence_field_id" string="No. Field/Sequences" invisible="number_sequence_option != 'field'"/>
                <div name="number_sequence_field_id" class="d-inline-flex w-100" invisible="number_sequence_option != 'field'">
                    <field
                        name="number_sequence_field_id"
                        options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"
                        domain="[('model', '=', model), ('ttype', 'in', ['boolean', 'many2one', 'selection'])]"
                    />
                    <button
                        name="action_goto_sequences"
                        type="object"
                        icon="fa-list"
                        invisible="not number_sequence_field_id"
                        title="Sequences"
                    />
                </div>
            </field>
        </field>
    </record>
</odoo>
