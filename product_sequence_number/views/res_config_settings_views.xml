<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <record id="res_config_settings_view_form_product_display" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.product_display</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="product.res_config_settings_view_form" />
            <field name="arch" type="xml">
                <xpath expr="//block[@id='product_general_settings']" position="after">
                    <block title="Product No.">
                        <setting
                            string="Product Variant No. Expression"
                            documentation="https://github.com/loym-com/apps-sequence/blob/18.0/base_sequence_number/readme/CONFIGURE.md"
                        >
                            <field name="product_product_number_expression" placeholder="{r.sequence_code}" class="w-100"/>
                        </setting>
                        <setting
                            string="Product Variant No. Sequence"
                            documentation="https://github.com/loym-com/apps-sequence/blob/18.0/base_sequence_number/readme/CONFIGURE.md"
                        >
                            <div class="content-group">
                                <div class="row mt16">
                                    <field name="product_product_number_sequence_option" class="w-100"/>
                                </div>
                                <div class="row mt16" invisible="product_product_number_sequence_option != 'sequence'">
                                    <field name="product_product_number_sequence_id" class="w-100"/>
                                </div>
                                <div class="row mt16" invisible="product_product_number_sequence_option != 'field'">
                                    <div class="d-inline-flex">
                                        <field
                                            name="product_product_number_sequence_field_id"
                                            class="w-100"
                                            options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"
                                            domain="[('model', '=', 'product.product'), ('ttype', 'in', ['boolean', 'many2one', 'selection'])]"
                                        />
                                        <button
                                            name="product_product_action_goto_sequences"
                                            type="object"
                                            icon="fa-list"
                                            invisible="not product_product_number_sequence_field_id"
                                            title="Sequences"
                                        />
                                    </div>
                                </div>
                            </div>
                        </setting>
                        <setting
                            string="Product Template No. Expression"
                            documentation="https://github.com/loym-com/apps-sequence/blob/18.0/base_sequence_number/readme/CONFIGURE.md"
                        >
                            <field name="product_template_number_expression" placeholder="{r.sequence_code}" class="w-100"/>
                        </setting>
                        <setting
                            string="Product Template No. Sequence"
                            documentation="https://github.com/loym-com/apps-sequence/blob/18.0/base_sequence_number/readme/CONFIGURE.md"
                        >
                            <div class="content-group">
                                <div class="row mt16">
                                    <field name="product_template_number_sequence_option" class="w-100"/>
                                </div>
                                <div class="row mt16" invisible="product_template_number_sequence_option != 'sequence'">
                                    <field name="product_template_number_sequence_id" class="w-100"/>
                                </div>
                                <div class="row mt16" invisible="product_template_number_sequence_option != 'field'">
                                    <div class="d-inline-flex">
                                        <field
                                            name="product_template_number_sequence_field_id"
                                            class="w-100"
                                            options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"
                                            domain="[('model', '=', 'product.template'), ('ttype', 'in', ['boolean', 'many2one', 'selection'])]"
                                        />
                                        <button
                                            name="product_template_action_goto_sequences"
                                            type="object"
                                            icon="fa-list"
                                            invisible="not product_template_number_sequence_field_id"
                                            title="Sequences"
                                        />
                                    </div>
                                </div>
                            </div>
                        </setting>
                        <setting string="Get Product Template No. from Main Variant">
                            <field name="product_template_sequence_number_from_main_variant"/>
                        </setting>
                    </block>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
