<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <record id="res_config_settings_view_form" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.project_sequence_number</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="project.res_config_settings_view_form" />
            <field name="arch" type="xml">
                <xpath expr="//app[@name='project']" position="inside">
                    <block name="project_sequence_number" title="Project/Task No.">
                        <setting
                            string="Project No. Expression"
                            documentation="https://github.com/loym-com/apps-sequence/blob/18.0/base_sequence_number/readme/CONFIGURE.md"
                        >
                            <field name="project_project_number_expression" placeholder="{r.sequence_code}" class="w-100"/>
                        </setting>
                        <setting
                            string="Project No. Sequence"
                            documentation="https://github.com/loym-com/apps-sequence/blob/18.0/base_sequence_number/readme/CONFIGURE.md"
                        >
                            <div class="content-group">
                                <div class="row mt16">
                                    <field name="project_project_number_sequence_option" class="w-100"/>
                                </div>
                                <div class="row mt16" invisible="project_project_number_sequence_option != 'sequence'">
                                    <field name="project_project_number_sequence_id" class="w-100"/>
                                </div>
                                <div class="row mt16" invisible="project_project_number_sequence_option != 'field'">
                                    <div class="d-inline-flex">
                                        <field
                                            name="project_project_number_sequence_field_id"
                                            class="w-100"
                                            options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"
                                            domain="[('model', '=', 'project.project'), ('ttype', 'in', ['boolean', 'many2one', 'selection'])]"
                                        />
                                        <button
                                            name="project_project_action_goto_sequences"
                                            type="object"
                                            icon="fa-list"
                                            invisible="not project_project_number_sequence_field_id"
                                            title="Sequences"
                                        />
                                    </div>
                                </div>
                            </div>
                        </setting>
                        <setting
                            string="Task No. Expression"
                            documentation="https://github.com/loym-com/apps-sequence/blob/18.0/base_sequence_number/readme/CONFIGURE.md"
                        >
                            <field name="project_task_number_expression" placeholder="{r.sequence_code}" class="w-100"/>
                        </setting>
                        <setting
                            string="Task No. Sequence"
                            documentation="https://github.com/loym-com/apps-sequence/blob/18.0/base_sequence_number/readme/CONFIGURE.md"
                        >
                            <div class="content-group">
                                <div class="row mt16">
                                    <field name="project_task_number_sequence_option" class="w-100"/>
                                </div>
                                <div class="row mt16" invisible="project_task_number_sequence_option != 'sequence'">
                                    <field name="project_task_number_sequence_id" class="w-100"/>
                                </div>
                                <div class="row mt16" invisible="project_task_number_sequence_option != 'field'">
                                    <div class="d-inline-flex">
                                        <field
                                            name="project_task_number_sequence_field_id"
                                            class="w-100"
                                            options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"
                                            domain="[('model', '=', 'project.task'), ('ttype', 'in', ['boolean', 'many2one', 'selection'])]"
                                        />
                                        <button
                                            name="project_task_action_goto_sequences"
                                            type="object"
                                            icon="fa-list"
                                            invisible="not project_task_number_sequence_field_id"
                                            title="Sequences"
                                        />
                                    </div>
                                </div>
                            </div>
                        </setting>
                    </block>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
