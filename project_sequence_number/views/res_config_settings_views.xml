<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <record id="res_config_settings_view_form_project_display" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.project_display</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="project.res_config_settings_view_form" />
            <field name="arch" type="xml">
                <xpath expr="//app[@name='project']" position="inside">
                    <div class="app_settings_block" data-string="Display" string="Display">
                        <h2>Project and Task Display</h2>
                        <div class="row mt16 o_settings_container">
                            <div>
                                <p>Pattern examples:
                                    <b>5 digits</b>: {id:0>5} -
                                    <b>date</b>: {create_date:%Y-%m-%d} -
                                    <b>related</b>: {related_id.field} -
                                    <b>sequence</b>: {sequence_code}
                                </p>
                            </div>
                            <!-- <div class="col-12 col-lg-6 o_setting_box">
                                <field name="ir_model_project_project" invisible="1"/>
                                <label for="project_project_display_name_expression" string="Computed Project Name Pattern"/>
                                <field
                                    name="project_project_display_name_expression"
                                    class="w-100"
                                    placeholder="{sequence_number} - {name}"
                                />
                            </div>
                            <div class="col-12 col-lg-6 o_setting_box">
                                <field name="ir_model_project_task" invisible="1"/>
                                <label for="project_task_display_name_expression" string="Computed Task Name Pattern"/>
                                <field
                                    name="project_task_display_name_expression"
                                    class="w-100"
                                    placeholder="{sequence_number} - {name}"
                                />
                            </div> -->

                            <div class="col-12 col-lg-6 o_setting_box">
                                <field name="ir_model_project_project" invisible="1"/>
                                <label for="project_project_number_expression" string="Stored Unique Project No. Pattern"/>
                                <field
                                    name="project_project_number_expression"
                                    class="w-100"
                                    placeholder="{sequence_code}"
                                />
                            </div>
                            <div class="col-12 col-lg-6 o_setting_box">
                                <field name="ir_model_project_task" invisible="1"/>
                                <label for="project_task_number_expression" string="Stored Unique Task No. Pattern"/>
                                <field
                                    name="project_task_number_expression"
                                    class="w-100"
                                    placeholder="{sequence_code}"
                                />
                            </div>

                            <div class="col-12 col-lg-6 o_setting_box">
                                <field name="ir_model_project_project" invisible="1"/>
                                <label for="project_project_number_sequence_id" string="Project Sequence"/>
                                <field name="project_project_number_sequence_id" class="w-100"/>
                            </div>
                            <div class="col-12 col-lg-6 o_setting_box">
                                <field name="ir_model_project_task" invisible="1"/>
                                <label for="project_task_number_sequence_id" string="Task Sequence"/>
                                <field name="project_task_number_sequence_id" class="w-100"/>
                            </div>
                        </div>
                    </div>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
