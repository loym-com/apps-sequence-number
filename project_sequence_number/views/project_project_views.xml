<data>
    <record id="project_project_view_form" model="ir.ui.view">
        <field name="name">project.project.view.form.sequence_number</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project" />
        <field name="arch" type="xml">
            <h1 position="before">
                <div class="d-flex h3">
                    <!-- <label for="sequence_number" string="No." /> -->
                    <field name="sequence_number" decoration-bf="1" readonly="1" />
                </div>
            </h1>
        </field>
    </record>
    <record id="project_project_view_tree" model="ir.ui.view">
        <field name="name">project.project.view.tree.sequence_number</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.view_project" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="before">
                <field name="sequence_number" readonly="1" optional="hide" />
            </xpath>
        </field>
    </record>
    <record id="project_project_view_kanban" model="ir.ui.view">
        <field name="name">project.project.view.kanban.sequence_number</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.view_project_kanban" />
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('o_project_kanban_main')]" position="before">
                <div class="d-flex flex-column">
                    <div class="d-flex mb-0 h3">
                        <field name="sequence_number" string="Product No." decoration-bf="1" readonly="1"/>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</data>
